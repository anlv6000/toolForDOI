# Google Gemini API Key (Required for LLM generation)
# Obtain from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Embeddings: local uses Sentence Transformers; google uses Gemini embeddings
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DEVICE=cuda

# Keep SSL certificate verification enabled. Set false only for a known broken publisher host.
VERIFY_SSL=true

# Unpaywall Email (Required by Unpaywall API - must be a valid email format, e.g., name@domain.com)
UNPAYWALL_EMAIL=your_email@example.com

# Semantic Scholar API Key (Optional - allows higher rate limits)
# Obtain from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_s2_api_key_here
